{
  "name": "transplant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx server/src/main.ts",
    "start": "node --env-file-if-exists=.env --import tsx server/src/main.ts",
    "web": "vite",
    "build:web": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "hoods": "node --import tsx scripts/fetch-hoods.ts",
    "record": "node --env-file=.env --import tsx scripts/record-fixtures.ts",
    "lift-report": "node --import tsx scripts/lift-report.ts",
    "smoke-tools": "node --env-file=.env --import tsx scripts/smoke-tools.ts"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/gloock": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@hono/node-server": "2.1.3",
    "hono": "4.13.11",
    "maplibre-gl": "6.11.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  }
}
